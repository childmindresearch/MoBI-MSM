# Copy to .env and fill in. Never commit .env.

# Model calls go through LiteLLM, so the vendor is part of the model id and
# credentials come from that vendor's own variable. Set the one you use.
ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...

# LLM provider: "litellm" for real runs, "fake" for development/testing
# with a deterministic canned responder that needs no API key.
MOBI_LLM_PROVIDER=litellm

# Any LiteLLM model id: anthropic/claude-opus-5, openai/gpt-5,
# gemini/gemini-2.5-pro, bedrock/..., ollama/llama3.3 for a local model.
MOBI_LLM_MODEL=anthropic/claude-opus-5

# Reasoning effort, sent to the vendors that support it and dropped for the
# rest. Lower effort means lower and steadier latency. Empty to omit entirely.
MOBI_LLM_EFFORT=low

# Optional. Models tried in order if the primary one fails, so a vendor outage
# does not stall a trial. Leave unset if the study must not change models
# mid-session without you knowing.
# MOBI_LLM_FALLBACK_MODELS=openai/gpt-5,gemini/gemini-2.5-pro

# Optional. Route every call through a LiteLLM proxy server instead of calling
# vendors directly -- one place for keys, budgets, and logging across the lab.
# The vendor keys above then live on the proxy, not on the lab machine.
#
# Addressing a proxy takes BOTH of these AND a litellm_proxy/ model id. Without
# the prefix the call goes to the vendor's own handler pointed at the proxy URL,
# which is not a route the proxy serves. The app warns at startup if you set an
# api_base without a matching model id.
#
# MOBI_LLM_API_BASE=http://127.0.0.1:4000
# MOBI_LLM_API_KEY=sk-...
# MOBI_LLM_MODEL=litellm_proxy/claude-opus-5   <- name as configured ON THE PROXY

# Directory holding assignment.csv and the three key CSVs.
MOBI_FIXTURES_DIR=test-fixtures

# Where session data and marker logs are written.
MOBI_DATA_DIR=data

# Development only. Section 12 pins the interface to one embedded webfont,
# because every size in the stylesheet is computed against that font's metrics.
# With the font missing the app refuses to start a session; setting this runs it
# anyway on a system fallback and records the substitution in the session record.
# NEVER set this for data collection.
# MOBI_ALLOW_SYSTEM_FONT=1
