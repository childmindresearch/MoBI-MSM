# Copy to .env and fill in. Never commit .env.
#
# Pick ONE of the two credential setups below. A LiteLLM gateway is how this
# lab runs; calling a vendor directly is the simpler option for a standalone
# machine or for development.


# === Option A: a LiteLLM proxy / gateway (what this lab uses) =============
#
# Vendor keys live on the proxy, so this machine holds only a virtual key.
# This takes THREE settings together, not two -- the litellm_proxy/ prefix is
# what routes the call to the gateway. Set an api_base with a plain vendor
# model id instead and LiteLLM sends vendor-shaped requests to the proxy's
# URL, which is not a route it serves; the app warns at startup if it sees
# that combination.

MOBI_LLM_API_BASE=https://litellm.your-org.example
MOBI_LLM_API_KEY=sk-...

# The model name AS CONFIGURED ON THE PROXY, not the vendor's own id -- your
# proxy decides what it is called. Ask it what it has:
#   curl -s $MOBI_LLM_API_BASE/v1/models -H "Authorization: Bearer $MOBI_LLM_API_KEY"
MOBI_LLM_MODEL=litellm_proxy/claude-opus-5


# === Option B: call a vendor directly ====================================
#
# Comment out Option A above, then set the model id and that vendor's own
# credential variable. Any LiteLLM model id works: anthropic/claude-opus-5,
# openai/gpt-5, gemini/gemini-2.5-pro, bedrock/..., ollama/llama3.3 for a
# local model.
#
# MOBI_LLM_MODEL=anthropic/claude-opus-5
# ANTHROPIC_API_KEY=sk-ant-...
# OPENAI_API_KEY=sk-...
# GEMINI_API_KEY=...


# === Everything else ======================================================

# "litellm" for real runs, "fake" for development/testing with a
# deterministic canned responder that needs no key and no network.
MOBI_LLM_PROVIDER=litellm

# Reasoning effort. Empty on purpose: LiteLLM maps this to extended thinking,
# which is heavier than it sounds. Measured on one gateway it moved mean
# latency from ~2.5 s to ~6.7 s (max 8.2 s) -- straddling the 7 s
# THINKING_SLOW_AFTER_MS threshold, so the thinking indicator's state would
# differ across trials for no experimental reason. Set it only deliberately,
# and move that threshold clear of the latency spread if you do.
MOBI_LLM_EFFORT=

# Optional. Models tried in order if the primary one fails, so a vendor outage
# does not stall a trial. Leave unset if the study must not change models
# mid-session without you knowing.
# MOBI_LLM_FALLBACK_MODELS=openai/gpt-5,gemini/gemini-2.5-pro

# Directory holding assignment.csv and the three key CSVs.
MOBI_FIXTURES_DIR=test-fixtures

# Where session data and marker logs are written.
MOBI_DATA_DIR=data

# Development only, and only with MOBI_LLM_PROVIDER=fake. Artificial delay on
# the canned responder so the thinking indicator and its slow state can be
# rehearsed without calling a real model. Set to 9 to see the slow state.
# MOBI_FAKE_LLM_DELAY_S=2.5

# Development only. Section 12 pins the interface to one embedded webfont,
# because every size in the stylesheet is computed against that font's metrics.
# With the font missing the app refuses to start a session; setting this runs it
# anyway on a system fallback and records the substitution in the session record.
# NEVER set this for data collection.
# MOBI_ALLOW_SYSTEM_FONT=1
